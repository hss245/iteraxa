{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iteraxa",
  "version": "0.4.0",
  "identifier": "dev.iteraxa.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Iteraxa",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Goal runner for Claude Code and Codex",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/ixd", "binaries/ixpack"],
    "resources": {
      "../python/iteraxa/*.py": "python/iteraxa/"
    },
    "linux": {
      "deb": {
        "depends": ["python3"]
      }
    }
  }
}
